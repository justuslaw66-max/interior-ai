{
  "name": "interior-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11.6.2 <12"
  },
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "node scripts/prisma-generate.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "assets:inventory": "node scripts/asset-inventory.mjs",
    "assets:inventory:strict": "node scripts/asset-inventory.mjs --strict",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/00-runtime-smoke.spec.ts",
    "test:e2e:smart-placement": "playwright test tests/e2e/17-smart-placement-smoke.spec.ts",
    "test:e2e:pro-upgrade": "playwright test tests/e2e/pro-upgrade.spec.ts",
    "dev:stripe": "node scripts/dev-stripe.mjs",
    "test:stripe-pro": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-stripe-pro-billing.ts && npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/test-pro-billing-ui.ts",
    "test:pro-billing:local": "node scripts/dev-stripe.mjs --test",
    "backup:workspace": "node scripts/backup-workspace.mjs",
    "dev": "node scripts/dev-preflight.mjs && npm run dev:hot",
    "dev:bg": "node scripts/dev-background.mjs",
    "dev:hot": "env -u DEBUG next dev --webpack --hostname 0.0.0.0 --port 3000",
    "dev:fresh": "npm run clean:next-dev-cache && npm run dev:hot",
    "dev:webpack": "env -u DEBUG next dev --webpack --hostname 0.0.0.0 --port 3000",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "dev:check": "node scripts/dev-doctor.mjs",
    "dev:smoke": "node scripts/dev-smoke.mjs",
    "dev:stop": "PORT=${PORT:-3000}; PID=$(lsof -ti tcp:$PORT); if [ -n \"$PID\" ]; then kill $PID; echo \"Stopped dev server on port $PORT: $PID\"; else echo \"No dev server found on port $PORT\"; fi",
    "dev:restart": "npm run dev:stop && npm run dev:fresh",
    "dev:stable": "npm run dev:hot",
    "dev:prod": "npm run build && next start",
    "clean:next-dev-cache": "rm -rf .next/dev",
    "clean:turbopack-cache": "rm -rf .next/dev/cache/turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:floor-plan-library": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-floor-plan-library.ts",
    "test:design-page-house-plan": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-house-plan.ts",
    "test:design-page-equivalent-variant": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-equivalent-variant.ts",
    "test:design-page-save-status": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-save-status.ts",
    "test:design-page-history-controller": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-history-controller.ts",
    "test:design-page-layout-versions-and-views-controller": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-layout-versions-and-views-controller.ts",
    "test:design-page-live-catalog": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-live-catalog.ts",
    "test:design-page-ai-layout-controller": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-ai-layout-controller.ts",
    "test:design-page-selection-transforms": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-selection-transforms.ts",
    "test:design-page-room-plan-controller": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-room-plan-controller.ts",
    "test:design-page-plan-quality-controller": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-plan-quality-controller.ts",
    "test:design-page-plan-overlay-controller": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-plan-overlay-controller.ts",
    "test:design-page-selection-inspector-model": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-selection-inspector-model.ts",
    "test:design-page-selected-item-panel": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-selected-item-panel.ts",
    "test:design-page-selected-item-panel-controller": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-selected-item-panel-controller.ts",
    "test:design-page-plan-canvas-overlays": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-plan-canvas-overlays.ts",
    "test:design-page-scene-layers": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-scene-layers.ts",
    "test:design-page-viewport-selection-controls": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-viewport-selection-controls.ts",
    "test:design-page-zone-controller": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-zone-controller.ts",
    "test:design-page-selection-keyboard": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-placement-keyboard-shortcuts.ts",
    "test:design-page-cabinetry-controller": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-design-page-cabinetry-controller.ts",
    "test:floor-manager": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-floor-manager-logic.ts",
    "test:floor-plan-quality": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-floor-plan-quality.ts",
    "test:designer-theme-contrast": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/test-designer-theme-contrast.ts",
    "test:pro-visual-policy": "npx playwright test -c playwright.pro-visual.config.ts",
    "test:room-resize-handle-style": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/test-room-resize-handle-style.ts",
    "import:gardenia-surfaces": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/import-gardenia-surface-materials.ts",
    "test:catalog-audit": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-catalog-quality-audit.ts && npm run test:catalog-editor-coverage && npm run test:dalton-catalog-media",
    "test:catalog-editor-coverage": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-catalog-editor-coverage.ts",
    "test:dalton-catalog-media": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-dalton-catalog-media.ts",
    "test:catalog-asset-availability": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-catalog-asset-availability.ts",
    "test:cabinetry": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-cabinetry.ts && npm run test:cabinetry-numeric-input && npm run test:cabinetry-semantic-preview && npm run test:cabinetry-preview-renderer && npm run test:cabinetry-polygon-hosts && npm run test:cabinetry-wardrobe-arrangements && npm run test:cabinetry-template-recommendations && npm run test:cabinetry-template-catalog && npm run test:cabinetry-module-option-groups && npm run test:cabinetry-hardware-autofix && npm run test:cabinetry-onboarding && npm run test:cabinetry-preview-analytics",
    "test:cabinetry-numeric-input": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-cabinetry-numeric-input.ts",
    "test:cabinetry-semantic-preview": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-cabinetry-semantic-preview.ts",
    "test:cabinetry-preview-renderer": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-cabinetry-preview-renderer.ts",
    "test:cabinetry-polygon-hosts": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-cabinetry-polygon-hosts.ts",
    "test:cabinetry-wardrobe-arrangements": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-cabinetry-wardrobe-arrangements.ts",
    "test:cabinetry-template-recommendations": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-cabinetry-template-recommendations.ts",
    "test:cabinetry-template-catalog": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-cabinetry-template-catalog.ts",
    "test:cabinetry-module-option-groups": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-cabinetry-module-option-groups.ts",
    "test:cabinetry-hardware-autofix": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-cabinetry-hardware-autofix.ts",
    "test:cabinetry-performance": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-cabinetry-performance.ts",
    "test:cabinetry-accessibility": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\",\"jsx\":\"react-jsx\"}' -r tsconfig-paths/register scripts/test-cabinetry-accessibility.ts",
    "test:cabinetry-onboarding": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\",\"jsx\":\"react-jsx\"}' -r tsconfig-paths/register scripts/test-cabinetry-onboarding.ts",
    "test:cabinetry-preview-analytics": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-cabinetry-preview-analytics.ts",
    "check:cabinetry-release-evidence": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/check-cabinetry-release-evidence.ts",
    "report:cabinetry-release-evidence": "npm run check:cabinetry-release-evidence -- --report-only",
    "test:cabinetry-release-evidence": "npx ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/test-cabinetry-release-evidence.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@sentry/browser": "^10.42.0",
    "@sentry/nextjs": "^10.42.0",
    "@stripe/stripe-js": "^9.9.0",
    "lucide-react": "^0.468.0",
    "meshoptimizer": "^1.2.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.30",
    "openai": "^4.104.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "posthog-js": "^1.396.6",
    "posthog-node": "^5.39.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "stripe": "^22.3.0",
    "three": "^0.182.0",
    "three-stdlib": "^2.36.1",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.19.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.5.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
