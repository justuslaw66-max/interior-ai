# Local development. Copy only the keys you need into .env.local.
DATABASE_URL="postgresql://USER@localhost:5432/interior_ai_dev"
AUTH_SECRET="replace-with-a-long-random-value"
NEXTAUTH_URL="http://localhost:3000"
APP_ORIGIN="http://localhost:3000"

# Authentication providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Server-side key for Places API (New). Restrict this key to the Places API and
# to your deployed server IPs; never expose it through NEXT_PUBLIC_*.
GOOGLE_MAPS_API_KEY=""

# AI
OPENAI_API_KEY=""

# Stripe test mode
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""

# Catalog and commerce
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_API_VERSION="2026-04"
CATALOG_STRICT_VALIDATION="false"

# Optional analytics and monitoring
NEXT_PUBLIC_POSTHOG_KEY=""
POSTHOG_KEY=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""

# Optional application services
RESEND_API_KEY=""
EMAIL_FROM=""
ADMIN_EMAILS=""
# Public floor-plan lifecycle authority is deliberately narrower than general
# admin access. Use disjoint people for review and publication.
FLOOR_PLAN_REVIEWER_EMAILS=""
FLOOR_PLAN_PUBLISHER_EMAILS=""

# Floor-plan import platform
API_RATE_LIMIT_HASH_SECRET="replace-with-a-separate-long-random-value"
# Set to 0 for a fast rollback to the legacy single-pass extractor.
FLOOR_PLAN_IMPORT_ENHANCED_DETECTION="1"
# Production defaults to background processing. Run `npm run worker:floor-plans`
# as a durable worker, or set inline only for local/single-process development.
FLOOR_PLAN_PROCESSING_MODE="inline"
# Deep health checks report a degraded queue after this many seconds.
FLOOR_PLAN_QUEUE_MAX_WAIT_SECONDS="600"
# Admin queue attention thresholds.
FLOOR_PLAN_ADMIN_PROCESSING_SLA_HOURS="1"
FLOOR_PLAN_ADMIN_REVIEW_SLA_HOURS="24"
FLOOR_PLAN_PRIVATE_SOURCE_RETENTION_DAYS="30"
# External semantic classification is opt-in. Coordinates still come from
# deterministic vectors, registered raster evidence, CAD, or reviewed tracing.
FLOOR_PLAN_VISION_ENABLED="0"
FLOOR_PLAN_VISION_MODEL=""
# Byte persistence defaults to Postgres. Select s3 only after supplying every
# required private S3-compatible setting below; partial configuration fails.
FLOOR_PLAN_OBJECT_STORAGE_PROVIDER="database"
FLOOR_PLAN_S3_ENDPOINT=""
FLOOR_PLAN_S3_REGION=""
FLOOR_PLAN_S3_BUCKET=""
FLOOR_PLAN_S3_ACCESS_KEY_ID=""
FLOOR_PLAN_S3_SECRET_ACCESS_KEY=""
FLOOR_PLAN_S3_SESSION_TOKEN=""
FLOOR_PLAN_S3_ADDRESSING_STYLE="path"
FLOOR_PLAN_S3_KEY_PREFIX="floor-plans/v1"
# Separate 32+ byte secret used only to HMAC opaque object keys.
FLOOR_PLAN_OBJECT_STORAGE_KEY_SECRET=""
FLOOR_PLAN_S3_MAX_OBJECT_BYTES="33554432"
FLOOR_PLAN_S3_REQUEST_TIMEOUT_MS="30000"
# managed omits an SSE request header; AES256 is the secure AWS S3 default.
FLOOR_PLAN_S3_SERVER_SIDE_ENCRYPTION="AES256"
FLOOR_PLAN_S3_KMS_KEY_ID=""
